# ============================================================
# Environment Variables — copy to .env and fill in your values
# ============================================================
# NEVER commit .env to version control!
# .gitignore already excludes .env files.

# GEMINI_API_KEY: Your Google Gemini API key from AI Studio
# Get yours: https://aistudio.google.com/apikey
GEMINI_API_KEY="paste-your-key-here"

# APP_URL: The URL where this applet is hosted (auto-injected in AI Studio)
APP_URL="http://localhost:3000"
